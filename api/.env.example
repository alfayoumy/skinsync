# --- AI Verification Keys ---
# Primary: OpenCode Zen API Key (for jev-1.13-free)
OPENCODE_API_KEY=
# TYPESAFE_API_KEY=

# Fallback: Google Gemini API Key (for gemini-3.5-flash-lite fallback when Jev is unavailable)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_MAX_RPM=15
GEMINI_MAX_RPD=1500
GEMINI_PACE_DELAY_SECONDS=4.0
GEMINI_TIMEOUT_SECONDS=35.0

# --- Local ONNX Cross-Encoder ---
ENABLE_CROSS_ENCODER=True
CROSS_ENCODER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_CONFIDENCE_THRESHOLD=0.70

# --- Gate 1: INCI Quality & Entity Validation ---
# MIN_INGREDIENT_COUNT=3
# MIN_INGREDIENT_RAW_LEN=12
# MAX_INGREDIENT_RAW_LEN=2500

# --- Vector Search & Hybrid Candidate Scoring ---
# FASTEMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
# DENSE_VECTOR_WEIGHT=0.55
# SPARSE_TOKEN_WEIGHT=0.45
# TOP_K_CANDIDATES=5
